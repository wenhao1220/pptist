# Copy this file to .env and supply the same Bedrock values used locally.
# Never commit the real .env file or put these values in VITE_* variables.
BEDROCK_API_KEY=
BEDROCK_REGION=
BEDROCK_MODEL_ID=
BEDROCK_ENDPOINT=

# Production security controls. CORS_ORIGIN is a comma-separated list of the
# approved browser origins, for example: https://ppt.example.com
# Leave it empty only when Express serves the frontend from the same origin.
CORS_ORIGIN=
# Set true only behind a trusted AWS ALB/reverse proxy.
TRUST_PROXY=false
# Hard limits for unauthenticated browser requests and attachments.
API_RATE_LIMIT_MAX=60
UPLOAD_MAX_BYTES=10485760

# Optional: Google Apps Script webhook for the in-app issue-report form.
GOOGLE_FEEDBACK_WEBHOOK_URL=
GOOGLE_FEEDBACK_TOKEN=
